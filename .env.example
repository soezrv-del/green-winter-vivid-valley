# Cloudflare Worker bridging to xAI (set your live worker URL)
CLOUDFLARE_WORKER_URL=
VITE_CLOUDFLARE_WORKER_URL=

# Optional: direct xAI key (server-only). Prefer the Cloudflare worker.
# XAI_API_KEY=

# Optional NHTSA (public endpoints work without a key)
# NHTSA_API_KEY=

# MarketCheck RV inventory (server-only)
MARKETCHECK_API_KEY=
MARKETCHECK_BASE_URL=https://api.marketcheck.com/v2

# Capacitor live app URL (set when running cap:sync)
# CAP_SERVER_URL=https://your-app.vercel.app
